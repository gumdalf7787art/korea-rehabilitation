{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kpa-member-portal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "kpa-member-portal" }],
  "d1_databases": [{ "binding": "DB", "database_name": "kpa-portal-db", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "kpa-portal-files" }]
}
