    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "next": "^16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "wrangler": "^4.148.0"
  }
}
