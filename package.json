{
  "name": "korea-rehabilitation",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "wrangler dev",
